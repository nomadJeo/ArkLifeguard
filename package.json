{
  "name": "arkLifeguard",
  "version": "0.1.0",
  "description": "A static taint analysis framework for HarmonyOS applications, built on ArkAnalyzer.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arklifeguard": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-nullness-assets.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run --exclude test/nullness/NullnessArkDefectBench.test.ts",
    "test:watch": "vitest",
    "test:lifecycle": "vitest run test/lifecycle",
    "test:ifds": "vitest run test/ifds",
    "test:cli": "vitest run test/application test/report test/cli",
    "test:nullness": "vitest run test/nullness --exclude test/nullness/NullnessArkDefectBench.test.ts",
    "test:resource": "vitest run test/resource",
    "test:nullness:ir": "vitest run test/nullness/ArkTSNullSafetyIR.test.ts",
    "test:nullness:bench": "vite-node scripts/test-nullness-bench.ts",
    "test:nullness:real-apps": "vite-node scripts/test-nullness-real-apps.ts",
    "test:resource:real-apps": "vite-node scripts/test-resource-real-apps.ts",
    "cli": "vite-node src/cli/main.ts",
    "arkanalyzer": "arkanalyzer",
    "inspect:project-ir": "vite-node scripts/inspect-project-ir.ts",
    "inspect:dummymain": "vite-node scripts/inspect-dummymain.ts",
    "sync:real-apps": "vite-node scripts/sync-harmony-real-apps.ts"
  },
  "dependencies": {
    "arkanalyzer": "1.0.90",
    "commander": "13.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
